# GitHub Actions → Settings → Variables（非敏感配置）
# 复制到仓库 Variables，或本地调试时 export
#
# GitHub Pages: https://boyuxiao.github.io/daily-arXiv-ai-enhanced/
# 仓库: https://github.com/BoyuXiao/daily-arXiv-ai-enhanced

CATEGORIES=cs.LG, cs.DC, cs.AI
LANGUAGE=Chinese
# false: crawl and publish original abstracts without calling an AI API.
# true: try AI summaries; API failures still allow raw papers to be published.
ENABLE_AI=false
MODEL_NAME=deepseek-chat
# chat_completions: DeepSeek/OpenAI-compatible Chat Completions API
# responses: Codex/OpenAI-compatible Responses API relay
# Set the same variable in GitHub Actions Variables; run.sh only configures local runs.
OPENAI_API_MODE=chat_completions
# Optional, only for providers that support these Responses options:
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_OUTPUT_TOKENS=4096
# OPENAI_API_TIMEOUT=180
EMAIL=your-email@example.com
NAME=Your Name

# GitHub Actions → Settings → Secrets（敏感配置）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# TOKEN_GITHUB=          # 可选
# ACCESS_PASSWORD=       # 可选，站点访问密码
